{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brivel",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-14",
  // La web (web/dist) la sirve Cloudflare sin pasar por el Worker; el Worker solo atiende /api
  "assets": { "directory": "../web/dist", "run_worker_first": ["/api/*"] },
  // Creada el 2026-11-02 con `wrangler d1 create brivel --jurisdiction=eu`: los datos se quedan en la UE y no se puede
  // cambiar después (docs/SINCRONIZACION.md)
  "d1_databases": [{ "binding": "DB", "database_name": "brivel", "database_id": "4ecfd370-b140-406e-a1be-c59d183ac4ee", "migrations_dir": "migrations" }],
  // Solo en brivel.app: sin la dirección *.workers.dev, que sería otra copia pública de la web
  "routes": [{ "pattern": "brivel.app", "custom_domain": true }],
  "workers_dev": false,
  // Garmin Connect (/api/garmin/*): Worker privado `brivel-garmin`, porque la documentación de Garmin es confidencial
  "services": [{ "binding": "GARMIN", "service": "brivel-garmin" }],
  // Borrado diario de las copias sin uso en 12 meses (scheduled en src/index.ts)
  "triggers": { "crons": ["0 3 * * *"] },
  // Contra abusos (docs/SINCRONIZACION.md): por IP en toda la API, altas por IP y subidas por cuenta. Aproximados, no
  // estrictos; los acotan también el tope de 1 MB por cuenta
  "ratelimits": [
    { "name": "POR_IP", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
    { "name": "ALTAS", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } },
    { "name": "SUBIDAS", "namespace_id": "1003", "simple": { "limit": 20, "period": 60 } }
  ]
}
